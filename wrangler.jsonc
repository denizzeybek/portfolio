{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    // History-mode routes (/blog/<slug>) have no file on disk, so unmatched paths serve index.html.
    "not_found_handling": "single-page-application",
    // The prerendered pages live in directories; serve them without the trailing slash the
    // default adds, so the URL matches the canonical tag and the sitemap.
    "html_handling": "drop-trailing-slash"
  },
  // Attached on deploy: wrangler creates the DNS records and the certificate in the same account.
  "routes": [
    { "pattern": "denizzeybek.dev", "custom_domain": true },
    { "pattern": "www.denizzeybek.dev", "custom_domain": true }
  ]
}

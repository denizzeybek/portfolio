{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    // History-mode routes (/blog/<slug>) have no file on disk, so unmatched paths serve index.html.
    "not_found_handling": "single-page-application"
  }
}
